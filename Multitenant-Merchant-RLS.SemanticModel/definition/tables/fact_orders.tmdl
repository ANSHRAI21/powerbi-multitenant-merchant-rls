	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_orders.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    BlankToNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(BlankToNull, {{"OrderID", Int64.Type}, {"DateKey", Int64.Type}, {"MerchantKey", Int64.Type}, {"CustomerID", type text}, {"Channel", type text}, {"Status", type text}, {"GrossAmountEUR", Currency.Type}, {"DiscountEUR", Currency.Type}, {"RefundEUR", Currency.Type}, {"PaymentFeeEUR", Currency.Type}}, "en-US"),
