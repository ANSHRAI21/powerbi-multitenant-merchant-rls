table security_user_access
	lineageTag: 15cbd779-7e7c-4ea2-91e2-800a8fbe2c03
	isHidden

	column UserEmail
		dataType: string
		lineageTag: cecabddb-0500-4569-8c1b-c69b255ff218
		summarizeBy: none
		sourceColumn: UserEmail

	column Role
		dataType: string
		lineageTag: a7cd4f10-7f70-4327-9101-bce9d9629047
		summarizeBy: none
		sourceColumn: Role

	column Region
		dataType: string
		lineageTag: 51cf7da9-27f2-4745-92b1-00d218ffdd29
