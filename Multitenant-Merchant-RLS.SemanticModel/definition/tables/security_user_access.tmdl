		summarizeBy: none
		sourceColumn: MerchantID

	partition security_user_access = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "security_user_access.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    BlankToNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(BlankToNull, {{"UserEmail", type text}, {"Role", type text}, {"Region", type text}, {"MerchantID", type text}}, "en-US"),
				    Final = Typed
				in
				    Final

